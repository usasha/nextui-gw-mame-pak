# =============================================================================
# pins.env — single source of truth for the reproducible build & package
# Every version, digest and checksum the build depends on lives here.
# =============================================================================

# --- MAME --------------------------------------------------------------------
# MAME 0.223 — the oldest release with full Game & Watch support.
# C++14 => compiles with the stock GCC 9 in Ubuntu 20.04; GENie rebuilds from
# its in-tree source when the prebuilt x86_64 binary is removed (build.sh).
MAME_REPO=https://github.com/mamedev/mame
MAME_TAG=mame0223
# Exact commit the tag must resolve to; verified after the shallow clone.
# Amend consciously (and re-test the patches) if mamedev ever re-points it.
MAME_COMMIT=c55a261d26d225c5c847c046f729290139b6546e
# G&W-only subset build: the hh_sm510 driver (+ its auto-detected deps).
# ~50 MB binary instead of ~700 MB, ~12 min compile instead of ~1 h.
MAME_SOURCES=src/mame/drivers/hh_sm510.cpp

# --- Build environment ---------------------------------------------------------
# ubuntu:20.04 (glibc 2.31 <= device runtime) pinned by the linux/arm64
# manifest digest of the tag at pin time — base layers can never drift.
DOCKER_BASE_IMAGE=ubuntu@sha256:722ea796ac2d57eeb3627c58a582fc1acc58be51faf815e1bce1682ae5c092f7

# apt pinned to a snapshot.ubuntu.com timestamp: gcc/g++/lld and every other
# installed package are frozen as of that date, so the toolchain is identical
# on any rebuild. Set APT_USE_SNAPSHOT=0 to fall back to the live archive.
APT_USE_SNAPSHOT=1
APT_SNAPSHOT_DATE=20261101T000000Z

# --- SDL2 (build-time dependency only) ---------------------------------------
# SDL2 2.0.20 — the last release with the fbcon video driver. libSDL2 built
# here is bundled in the pak as a self-contained fallback, but at runtime the
# device's own SDL2 from /usr/trimui/lib (mali fbdev driver) takes precedence
# (see pak/launch.sh).
SDL2_VERSION=2.0.20
SDL2_URL=https://github.com/libsdl-org/SDL/releases/download/release-2.0.20/SDL2-2.0.20.tar.gz
SDL2_SHA256=c56aba1d7b5b0e7e999e4a7698c70b63a3394ff9704b5f6e1c57e0c16f04dd06

# --- Build knobs ----------------------------------------------------------------
# MAME's emumem.cpp needs ~2-3 GB per compile job; 4 jobs is the safe ceiling
# for the ~8 GB Docker Desktop VM.
BUILD_JOBS=4
# OPTIMIZE=2 instead of the default 3: massively reduces cc1plus memory on
# the giant driver files, keeping the VM stable. G&W games are trivial to
# emulate — no performance impact.
OPTIMIZE=2

# --- Pak identity -----------------------------------------------------------------
PLATFORM=tg5040
PAK_TAG=GW_MAME
ROM_FOLDER="Game & Watch MAME (GW_MAME)"
